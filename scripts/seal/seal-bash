#!/usr/bin/env bash
# Custom Actions shell that seals a step's output: `shell: seal-bash {0}` runs the
# script like `shell: bash`; `shell: seal-bash-e {0}` like GitHub's implicit default.
# Output goes straight to a file (no pipe, so background processes can't hold the
# step open). Afterwards only the script's ::add-mask:: lines and one marker line
# reach the public log; the output and step summary are age-encrypted to the repo key.
# Values a sealed step masks are kept in $RUNNER_TEMP/seal/masks (mode 600, never
# uploaded) and replaced by *** in this and every later sealed segment of the job;
# masks registered by other actions are unknown here.
set -euo pipefail

case "${0##*/}" in
  seal-bash)   flags="--noprofile --norc -eo pipefail" ;;
  seal-bash-e) flags="-e" ;;
  *) echo "seal: unknown shell mode ${0##*/}" >&2; exit 2 ;;
esac
[ $# -eq 1 ] || { echo "usage: ${0##*/} <script>" >&2; exit 2; }
script=$1

seal="${RUNNER_TEMP:?}/seal"
age="$seal/bin/age"
key="$seal/repo-key.pub"
if ! { [ -x "$age" ] && [ -s "$key" ] && [ -s "$seal/artifact-name" ]; }; then
  echo "seal: toolkit is not installed; add the 'Seal job output' step first" >&2
  exit 1
fi
name=$(cat "$seal/artifact-name")
# The viewer reads a link without repo= as this repo (actions); never emit an empty repo=.
repo=${GITHUB_REPOSITORY:-}
repo=${repo#*/}
repo=${repo:+repo=$repo&}
n=$(($(cat "$seal/seq") + 1))
echo "$n" >"$seal/seq"
log="$seal/log/$n.log"
summary="$seal/log/$n.summary.md"
: >"$log"
: >"$summary"

# redact log|summary <file>: the file as bytes with each ::add-mask:: line's value
# replaced by *** and, like the runner, every occurrence of every known mask (overlapping
# ones too) found in the original bytes, merged into one *** per run of touching matches.
# The log pass first records its masks. Masks never match inside a rewritten add-mask line.
REDACT='
import bisect, os, re, sys
mode, masks, src = sys.argv[1:]
cmd = re.compile(rb"^([^\S\n]*::add-mask::)([^\n]*?)(\r*)$", re.M)
data = open(src, "rb").read()
found = list(cmd.finditer(data))
lines = [(m.start(), m.end(), m.group(1) + b"***" + m.group(3)) for m in found]
starts = [s for s, _, _ in lines]
fd = os.open(masks, os.O_RDWR | os.O_APPEND | os.O_CREAT, 0o600)
os.fchmod(fd, 0o600)
with os.fdopen(fd, "r+b") as f:
    if mode == "log":
        f.write(b"".join(m.group(2) + b"\n" for m in found if m.group(2)))
        f.flush()
    f.seek(0)
    known = set()
    for v in f.read().split(b"\n"):
        for w in (v, v.rstrip(), v.strip()):
            known.update((w, w.replace(b"%0D", b"\r").replace(b"%0A", b"\n").replace(b"%25", b"%")))
spans = []
for v in known:
    if not v.strip():
        continue
    i = data.find(v)
    while i >= 0:
        s, e = i, i + len(v)
        k = max(bisect.bisect_right(starts, s) - 1, 0)
        while k < len(lines) and lines[k][0] < e:
            if lines[k][1] > s:
                if lines[k][0] > s:
                    spans.append((s, lines[k][0]))
                s = max(s, lines[k][1])
            k += 1
        if s < e:
            spans.append((s, e))
        i = data.find(v, i + 1)
merged = []
for s, e in sorted(spans):
    if merged and s <= merged[-1][1]:
        merged[-1][1] = max(merged[-1][1], e)
    else:
        merged.append([s, e])
out, pos = [], 0
for s, e, rep in sorted([(s, e, b"***") for s, e in merged] + lines):
    out += [data[pos:s], rep]
    pos = e
out.append(data[pos:])
sys.stdout.buffer.write(b"".join(out))
sys.stdout.buffer.flush()
'
redact() { python3 -I -c "$REDACT" "$1" "$seal/masks" "$2" 2>/dev/null; }

rc=1
child=
sealed=
signalled=

seal_now() {
  set +e
  trap '' INT TERM
  [ -n "$sealed" ] && return
  sealed=1
  # The runner trims leading whitespace before parsing a command, so an indented
  # ::add-mask:: still masks; forward it, minus the indentation.
  LC_ALL=C grep -a '^[[:space:]]*::add-mask::' "$log" | LC_ALL=C sed 's/^[[:space:]]*//'
  ok=1
  # pipefail: a failed redaction fails the seal, like a failed encryption.
  redact log "$log" | "$age" -R "$key" -o "$seal/out/$n.log.age" || ok=
  if [ -n "$ok" ] && [ -s "$summary" ]; then
    redact summary "$summary" | "$age" -R "$key" -o "$seal/out/$n.summary.md.age" || ok=
  fi
  rm -f "$log" "$summary"
  if [ -n "$ok" ]; then
    echo "🔒 sealed $name#$n https://ci.lascade.com/?${repo}run=${GITHUB_RUN_ID:-}&attempt=${GITHUB_RUN_ATTEMPT:-}"
  else
    rm -f "$seal/out/$n.log.age" "$seal/out/$n.summary.md.age"
    echo "🔒 seal failed for $name#$n"
    [ "$rc" -ne 0 ] || rc=1
  fi
}

# The runner cancels a step by signalling this process: SIGINT, then SIGTERM
# about 7.5 s later, then SIGKILL about 2.5 s after that.
# SIGINT goes to the step's process group, which may then finish cleanly.
on_int() {
  signalled=130
  [ -z "$child" ] || kill -s INT -- "-$child" 2>/dev/null || true
}
# SIGTERM goes to the group too; 1 s later the group is killed, so nothing that
# ignores signals outlives the step, and the output is sealed before SIGKILL.
on_term() {
  trap '' INT TERM
  rc=143
  if [ -n "$child" ]; then
    kill -s TERM -- "-$child" 2>/dev/null || true
    for _ in 1 2 3 4 5; do
      kill -0 "$child" 2>/dev/null || break
      sleep 0.2
    done
    kill -s KILL -- "-$child" 2>/dev/null || true
    # Reap it here so bash's "Killed" job notice can't reach the public log.
    wait "$child" 2>/dev/null || true
  fi
  exit 143
}

trap 'seal_now; exit "$rc"' EXIT
trap on_int INT
trap on_term TERM

# Job control while spawning puts the step in its own process group and keeps
# SIGINT at its default (async commands otherwise ignore it) and stdin inherited.
set -m
# shellcheck disable=SC2086
GITHUB_STEP_SUMMARY="$summary" bash $flags "$script" >"$log" 2>&1 &
child=$!
set +m
set +e
# A trapped signal interrupts `wait`; keep waiting while the step is alive.
while :; do
  wait "$child" 2>/dev/null
  rc=$?
  kill -0 "$child" 2>/dev/null || break
done
set -e
[ -z "$signalled" ] || rc=$signalled
