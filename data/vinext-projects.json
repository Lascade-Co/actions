          "images": {"binding":"IMAGES"}
        }
      },
      "production": {
        "infisical_env": "prod",
        "infisical_path": "/",
        "smoke_url": "https://www.roamjoy.com/about",
        "check_noindex": true,
        "bindings": {
          "kv_namespaces": [{"binding":"VINEXT_KV_CACHE","id":"364ab4f32599412294f6d368e9dcb529"}],
          "images": {"binding":"IMAGES"}
        }
      }
    }
  }
}
